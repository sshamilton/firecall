# Firecall Environment Configuration
# Copy this file to .env and fill in your local network endpoints and keys.

# OpenAI-Compatible LLM Endpoint for Dispatch Address & Incident Extraction
FIRECALL_LLM_ENABLED=true
FIRECALL_LLM_URL=http://localhost:8000/v1/chat/completions
FIRECALL_LLM_MODEL=gemma-4-26B-A4B-it
FIRECALL_LLM_API_KEY=
FIRECALL_LLM_TIMEOUT=10.0

# Optional Map Tile API Key (CARTO)
FIRECALL_CARTO_API_KEY=

# Optional Overrides for Existing Firecall Services
# FIRECALL_HA_URL=http://localhost:8123/api/webhook/ham_radio_message
# FIRECALL_WHISPER_URL=http://localhost:8001/v1/audio/transcriptions
# FIRECALL_AUDIO_BASE_URL=http://localhost:8085
